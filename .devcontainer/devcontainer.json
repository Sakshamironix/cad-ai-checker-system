{
  "name": "CAD AI Checker",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/cad-ai-checker/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ]
      }
    }
  },
  "forwardPorts": [
    8501,
    8000
  ],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit CAD AI Checker",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "CAD processing API",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements-api.txt && python -c \"import cadquery, ezdxf, streamlit, fastapi; print('CAD dashboard and API environment ready')\"",
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  },
  "postStartCommand": "bash scripts/start-dashboard.sh && python scripts/run-cad-api.py"
}
